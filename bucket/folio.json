                "extract_dir": "folio-$version",
                "hash": {
                    "url": "https://github.com/lulu-loopp/folio-terminal/releases/download/v$version-preview/SHA256SUMS.txt",
                    "regex": "([a-fA-F0-9]{64})\\s+$basename"
